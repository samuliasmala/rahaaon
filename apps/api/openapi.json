    "/api/admin/suggestions/{id}": {
      "patch": {
        "summary": "Apply editorial edits to a pending suggestion",
        "tags": [
          "Admin"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchSuggestion"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated suggestion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Suggestion"
                }
              }
            }
          },
          "400": {
            "description": "Virheellinen pyyntö",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Kirjautuminen vaaditaan",
            "content": {
