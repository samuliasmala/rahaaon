      }
    },
    "/api/suggestions": {
      "post": {
        "summary": "Submit a link to the editorial queue (anonymous)",
        "tags": [
          "Suggestions"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SuggestUrl"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Queued for editorial review",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Virheellinen pyyntö",
