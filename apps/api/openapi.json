{
  "openapi": "3.1.0",
  "info": {
    "title": "Rahaaon API",
    "version": "0.1.0",
    "description": "Crowdsourced tracker of wasteful public spending (rahaaon.fi)."
  },
  "servers": [
    {
      "url": "http://localhost:3001"
    }
  ],
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "not_found"
              },
              "message": {
                "type": "string",
                "example": "Ei löytynyt"
              },
              "details": {},
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "db": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "status",
          "db"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "email",
              "name"
            ]
          }
        },
        "required": [
          "user"
        ]
      },
      "WasteItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "amountEur": {
            "type": "integer"
          },
          "entity": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "sourceName": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "votes": {
            "type": "integer"
          },
          "voted": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "amountEur",
          "entity",
          "category",
          "sourceName",
          "sourceUrl",
          "summary",
          "quote",
          "hidden",
          "publishedAt",
          "votes",
          "voted"
        ]
      },
      "Category": {
        "type": "string",
        "enum": [
          "Rakentaminen",
          "IT-hankkeet",
          "Konsultit",
          "Kulttuuri",
          "Viestintä",
          "Matkustus",
          "Muu"
        ]
      },
      "VoteResult": {
        "type": "object",
        "properties": {
          "votes": {
            "type": "integer"
          },
          "voted": {
            "type": "boolean"
          }
        },
        "required": [
          "votes",
          "voted"
        ]
      },
      "PatchItem": {
        "type": "object",
        "properties": {
          "hidden": {
            "type": "boolean"
          }
        },
        "required": [
          "hidden"
        ]
      },
      "SuggestionPreview": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "amountEur": {
            "type": "integer"
          },
          "entity": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "sourceName": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "aiNote": {
            "type": "string"
          },
          "confidence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "title",
          "amountEur",
          "entity",
          "category",
          "sourceName",
          "summary",
          "aiNote",
          "confidence"
        ]
      },
      "SuggestUrl": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2000,
            "format": "uri"
          }
        },
        "required": [
          "url"
        ]
      },
      "Suggestion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "amountEur": {
            "type": "integer"
          },
          "entity": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "sourceName": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "aiNote": {
            "type": "string"
          },
          "confidence": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "url",
          "title",
          "amountEur",
          "entity",
          "category",
          "sourceName",
          "summary",
          "aiNote",
          "confidence",
          "createdAt"
        ]
      },
      "PatchSuggestion": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "amountEur": {
            "type": "integer",
            "minimum": 0
          },
          "entity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          }
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Liveness probe",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "Palvelinvirhe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "summary": "Readiness probe (checks the database)",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Service and dependencies are ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "Current editorial user, or null when not signed in",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "Current principal, or null for anonymous visitors",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Me"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/items": {
      "get": {
        "summary": "Published feed items (visible only), newest first",
        "tags": [
          "Items"
        ],
        "responses": {
          "200": {
            "description": "Items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WasteItem"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Virheellinen pyyntö",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Kirjautuminen vaaditaan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Ei käyttöoikeutta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Ei löytynyt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validointivirhe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Palvelinvirhe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/items/{id}/vote": {
      "post": {
        "summary": "Toggle the visitor's \"this is a waste\" vote",
        "tags": [
          "Items"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "New vote count and the visitor's vote state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoteResult"
                }
              }
            }
          },
          "400": {
            "description": "Virheellinen pyyntö",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Kirjautuminen vaaditaan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Ei käyttöoikeutta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Ei löytynyt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validointivirhe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Palvelinvirhe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/items": {
      "get": {
        "summary": "All published items including hidden ones (editorial)",
        "tags": [
          "Admin"
        ],
        "responses": {
          "200": {
            "description": "Items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WasteItem"
                  }
                }
              }
            }
          },
          "400": {
