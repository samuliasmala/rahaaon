# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development

# API log verbosity: fatal|error|warn|info|debug|trace|silent (default: debug locally).
# LOG_LEVEL=debug

# URLs
APP_URL=http://localhost:5174
API_URL=http://localhost:3001

# Database — local Docker postgres:17 (see docker-compose.yml), mapped to host
# port 5434 to avoid clashing with a host Postgres or other dev stacks.
DATABASE_URL=postgres://rahaaon:rahaaon@localhost:5434/rahaaon

# Auth — better-auth. Generate with: openssl rand -base64 32
AUTH_SECRET=dev-only-change-me-please-0000000000000000

# Password for the seeded editorial user (toimitus@rahaaon.fi), db:seed.
SEED_ADMIN_PASSWORD=rahaaon-dev

# AI pipeline (suggestion extraction). Leave empty to use the built-in mock
# extraction in local dev — no OpenAI account needed. Set a real key to run
# the actual LLM extraction. LLM_MODEL overrides the default (config/env.ts).
OPENAI_API_KEY=
# LLM_MODEL=gpt-5-mini

# Article archive — raw page text stored at submit time (local MinIO, see
# docker-compose.yml). Leave all four empty to skip archiving entirely.
S3_ENDPOINT=http://localhost:9002
S3_BUCKET=rahaaon
S3_ACCESS_KEY_ID=rahaaon
S3_SECRET_ACCESS_KEY=rahaaon-dev-minio
