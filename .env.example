# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development

# URLs
APP_URL=http://localhost:5174
API_URL=http://localhost:3001

# Database — local Docker postgres:17 (see docker-compose.yml), mapped to host
# port 5434 to avoid clashing with a host Postgres or other dev stacks.
DATABASE_URL=postgres://rahaaon:rahaaon@localhost:5434/rahaaon

# Auth — better-auth. Generate with: openssl rand -base64 32
AUTH_SECRET=dev-only-change-me-please-0000000000000000

# Password for the seeded editorial user (toimitus@rahaaon.fi), db:seed.
SEED_ADMIN_PASSWORD=rahaaon-dev
