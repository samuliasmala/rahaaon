# Template for the THREE deployed environments. On the VPS, copy this once per
# env and fill in real values — they are gitignored and never committed:
#
#   make env-deploy ENV=dev    # → .env.dev   (deploy/init-env.sh)
#   make env-deploy ENV=test   # → .env.test
#   make env-deploy ENV=prod   # → .env.prod
#
# What differs per env: APP_URL/API_URL (domain), WEB_PORT, BACKUP_ENV, DB
# password, secrets. Everything runs the CI-built production image;
# deploy/deploy.sh supplies IMAGE_TAG + REGISTRY at deploy time. See DEPLOYMENT.md.

# All deployed stacks run the production build (not local hot-reload dev).
NODE_ENV=production
PORT=3001

# Public origin (served by Caddy -> web/nginx). Same-origin API via nginx, so
# APP_URL == API_URL. Per env:
#   dev  -> https://dev.rahaaon.samcode.fi
#   test -> https://test.rahaaon.samcode.fi
#   prod -> https://rahaaon.samcode.fi
APP_URL=https://rahaaon.samcode.fi
API_URL=https://rahaaon.samcode.fi

# Web (nginx) host port — MUST be unique per env; Caddy proxies to it.
#   prod=8090  dev=8091  test=8092
WEB_PORT=8090

# Postgres — the bundled db service reads these; DATABASE_URL must match and use
# the compose service host `db`. Use a STRONG, DISTINCT password per env.
POSTGRES_USER=rahaaon
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=rahaaon
DATABASE_URL=postgres://rahaaon:change-me-strong-password@db:5432/rahaaon

# Secrets — REQUIRED. Generate distinct values per env: openssl rand -base64 32
AUTH_SECRET=

# Password for the seeded editorial user (toimitus@rahaaon.fi) — used when
# seeding a fresh stack: docker compose … run --rm api node dist/db/seed.js
SEED_ADMIN_PASSWORD=

# Object storage — DB backups (S3-compatible).
#   dev/test -> the bundled MinIO service (docker-compose.prod.yml, profile "minio"):
#       S3_ENDPOINT=http://minio:9000   S3_PROVIDER=Minio   S3_BUCKET=rahaaon
#       S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY = MinIO root creds (user >=3 chars,
#       pass >=8). Set MINIO_CONSOLE_PORT to publish the console on 127.0.0.1.
#   prod -> Cloudflare R2: real R2 endpoint + keys, S3_PROVIDER=Cloudflare, and
#       leave MINIO_CONSOLE_PORT unset (prod runs no minio service).
S3_ENDPOINT=
S3_BUCKET=rahaaon
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PROVIDER=Cloudflare            # dev/test: set to Minio
# MINIO_CONSOLE_PORT=9093         # dev/test only — unique per stack (dev 9093 / test 9094)

# Backups — label written into the object path (backups/<BACKUP_ENV>/...) and
# how long dumps are kept. Set per env: dev|test|prod.
BACKUP_ENV=prod
RETENTION_DAYS=30

# Observability (optional)
# BACKUP_PING_URL=                 # dead-man's-switch pinged on a successful backup
